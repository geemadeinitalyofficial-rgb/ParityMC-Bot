# ── Web Panel (Wispbyte) ─────────────────────
# Su Wispbyte lascia WEB_HOST=0.0.0.0
# La porta deve corrispondere a quella aperta nel firewall Wispbyte
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_SECRET=scegli_una_chiave_segreta_lunga
WEB_USERNAME=admin
WEB_PASSWORD=scegli_una_password_sicura

# URL pubblico (es: http://IP:8080 oppure https://panel.paritymc.it)
WEB_PUBLIC_URL=http://IP_WISPBYTE:8080
