# ── Discord ─────────────────────────────────
DISCORD_TOKEN=il_tuo_token_qui
GUILD_ID=1524538144198754445
PREFIX=!

# ── Ruoli ───────────────────────────────────
SUPPORT_ROLE_ID=
ADMIN_ROLE_ID=

# ── Canali ──────────────────────────────────
LOG_CHANNEL_ID=
TICKET_CATEGORY_ID=
PARTNERSHIP_CATEGORY_ID=
LEVEL_CHANNEL_ID=
